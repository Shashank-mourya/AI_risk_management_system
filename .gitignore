# secrets
.env
*.key
kaggle.json

# generated data — all reproducible from build_labels.py
*.pkl
*.rda
*.db
orders_labeled.csv
features.csv

# model artefacts
*.joblib
threshold.json
threshold_sweep.csv

# node
# Nothing here needs npm: the page loads Chart.js from a CDN and there is no
# build step. `npm install streamlit` was a mistake - that npm package is an
# empty placeholder, unrelated to the Python Streamlit this repo runs on - and
# it committed a node_modules/ holding two files and no code.
node_modules/

# python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# os
.DS_Store

# model artefacts (regenerable by notebooks/train_model.ipynb)
#
# artefacts/* , not artefacts/ : git cannot re-include a file whose parent
# DIRECTORY is excluded, so with `artefacts/` the four negations below were
# dead lines and the four files the Vercel deployment needs were silently left
# out of every commit. Excluding the contents instead leaves the directory
# itself visible to the negations.
artefacts/*
# ... but the Vercel deployment needs these small files committed:
!artefacts/model.joblib
!artefacts/scaler.joblib
!artefacts/threshold.json
!artefacts/threshold_sweep.csv

# synthetic rehearsal data: the .csv IS tracked (needed to upload to Kaggle),
# the .pkl is not (regenerable by make_synthetic_dataset.py)
data/synthetic_features.pkl

# The two figures the README embeds. artefacts/ is ignored because it is
# regenerable, but a README with broken images is worse than a duplicated PNG.
# Refresh with: cp artefacts/cost_vs_threshold.png artefacts/threshold_sensitivity.png docs/
!docs/
!docs/*.png
