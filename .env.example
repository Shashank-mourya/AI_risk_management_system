# ---------------------------------------------------------------------------
# AI Risk Manager — environment template
#
#   cp .env.example .env      then fill in the real values
#
# .env is gitignored and must NEVER be committed. This file is the committed
# template: keep the keys, never the values.
# ---------------------------------------------------------------------------

# --- LLM explanation layer (required for Phase 3) --------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comparison models for the AI/non-AI invariance figure
# (`python explain.py --invariance`). Three DIFFERENT models, so that
# three different paragraphs land beside one identical risk_probability.
# Used once, by a one-off command — not at runtime.
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_ALT=qwen/qwen3.8-27b

# --- Local paths (defaults are fine) ---------------------------------------
# SQLite, local, in the repo. No cloud database: the demo runs off risk.db,
# which build_database.py regenerates in ~20 seconds.
DATABASE_URL=sqlite:///risk.db
MODEL_PATH=artefacts/model.joblib
THRESHOLD_PATH=artefacts/threshold.json
SCALER_PATH=artefacts/scaler.joblib
