# Environment template.
#
#   cp .env.example .env      then fill in the real values
#
# .env is gitignored and must never be committed. Keep the keys here, never the
# values.

# --- explanation layer -------------------------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comparison models for the invariance figure. Used by
# `python explain.py --invariance`, not at runtime.
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_ALT=qwen/qwen3.8-27b

# --- local paths -------------------------------------------------------------
# SQLite, in the repo. No cloud database: the demo runs off risk.db, which
# build_database.py regenerates in ~20 seconds.
DATABASE_URL=sqlite:///risk.db

# Artefact overrides. The defaults in config.py point at artefacts/ and are
# what the training notebook writes, so leave these commented out unless you
# are pointing the demo at a different trained model.
# MODEL_PATH=artefacts/model.joblib
# SCALER_PATH=artefacts/scaler.joblib
# THRESHOLD_PATH=artefacts/threshold.json
